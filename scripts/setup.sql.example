-- DataMind Snowflake setup. Run in Snowsight as ACCOUNTADMIN.
-- Replace <your_user> (two places, at the bottom) with your Snowflake username.

USE ROLE ACCOUNTADMIN;

-- Create the small warehouse used by DataMind, suspended until the first query.
CREATE WAREHOUSE IF NOT EXISTS DATAMIND_WH
    WAREHOUSE_SIZE = 'XSMALL'
    AUTO_SUSPEND = 60
    AUTO_RESUME = TRUE
    INITIALLY_SUSPENDED = TRUE;

-- Create the DataMind database.
CREATE DATABASE IF NOT EXISTS DATAMIND_DB;

-- Create the public-data schema inside the DataMind database.
CREATE SCHEMA IF NOT EXISTS DATAMIND_DB.PUBLIC_DATA;

-- ---------------------------------------------------------------------------
-- Read-only role: used by the application to answer questions.
-- ---------------------------------------------------------------------------

-- Create the role used by the application for read-only queries.
CREATE ROLE IF NOT EXISTS DATAMIND_READER;

-- Allow the read-only role to use the DataMind warehouse.
GRANT USAGE ON WAREHOUSE DATAMIND_WH TO ROLE DATAMIND_READER;

-- Allow the read-only role to use the DataMind database.
GRANT USAGE ON DATABASE DATAMIND_DB TO ROLE DATAMIND_READER;

-- Allow the read-only role to use the public-data schema.
GRANT USAGE ON SCHEMA DATAMIND_DB.PUBLIC_DATA TO ROLE DATAMIND_READER;

-- Allow the read-only role to select from existing tables in the schema.
GRANT SELECT ON ALL TABLES IN SCHEMA DATAMIND_DB.PUBLIC_DATA TO ROLE DATAMIND_READER;

-- Automatically allow the read-only role to select from future tables in the schema.
GRANT SELECT ON FUTURE TABLES IN SCHEMA DATAMIND_DB.PUBLIC_DATA TO ROLE DATAMIND_READER;

-- ---------------------------------------------------------------------------
-- Loader role: used only for loading data and the data-change demo.
-- ---------------------------------------------------------------------------

-- Create the writer role used by scripts/load_data.py and the Phase 8 demo.
CREATE ROLE IF NOT EXISTS DATAMIND_LOADER;

-- Allow the loader role to use the DataMind warehouse.
GRANT USAGE ON WAREHOUSE DATAMIND_WH TO ROLE DATAMIND_LOADER;

-- Allow the loader role to use the DataMind database.
GRANT USAGE ON DATABASE DATAMIND_DB TO ROLE DATAMIND_LOADER;

-- Allow the loader role to use the public-data schema.
GRANT USAGE ON SCHEMA DATAMIND_DB.PUBLIC_DATA TO ROLE DATAMIND_LOADER;

-- The loader needs to read the source table to make a Snowflake clone for the demo.
GRANT SELECT ON ALL TABLES IN SCHEMA DATAMIND_DB.PUBLIC_DATA TO ROLE DATAMIND_LOADER;
GRANT SELECT ON FUTURE TABLES IN SCHEMA DATAMIND_DB.PUBLIC_DATA TO ROLE DATAMIND_LOADER;

-- write_pandas needs to create tables, a temporary stage and a file format.
GRANT CREATE TABLE ON SCHEMA DATAMIND_DB.PUBLIC_DATA TO ROLE DATAMIND_LOADER;
GRANT CREATE STAGE ON SCHEMA DATAMIND_DB.PUBLIC_DATA TO ROLE DATAMIND_LOADER;
GRANT CREATE FILE FORMAT ON SCHEMA DATAMIND_DB.PUBLIC_DATA TO ROLE DATAMIND_LOADER;

-- ---------------------------------------------------------------------------
-- Give both roles to your Snowflake user (same value as SNOWFLAKE_USER in .env).
-- ---------------------------------------------------------------------------
GRANT ROLE DATAMIND_READER TO USER <your_user>;
GRANT ROLE DATAMIND_LOADER TO USER <your_user>;

-- In .env use:
--   SNOWFLAKE_ROLE=DATAMIND_READER       (the app, read-only)
--   SNOWFLAKE_LOAD_ROLE=DATAMIND_LOADER  (data loading and the data-change demo)